<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <package android:name="com.meizu.voiceassistant" />
    </queries>
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_bridge"
        android:label="Aicy OpenAI Bridge"
        android:supportsRtl="true"
        android:theme="@style/Theme.AicyBridge"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".CallLogsActivity" android:exported="false" />
        <provider
            android:name=".SettingsProvider"
            android:authorities="io.github.aicybridge.settings"
            android:exported="true"
            android:grantUriPermissions="false" />
    </application>
</manifest>
